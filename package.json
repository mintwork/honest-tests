{
  "name": "honest-tests",
  "version": "0.1.0",
  "description": "Stop AI coding agents from writing fake tests. An agent skill + CLI that detects tests that can't fail, and proves it with mutation testing.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranjan-mohanty/honest-tests.git"
  },
  "homepage": "https://github.com/ranjan-mohanty/honest-tests#readme",
  "bugs": {
    "url": "https://github.com/ranjan-mohanty/honest-tests/issues"
  },
  "type": "module",
  "bin": {
    "honest-tests": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "commands",
    "integrations",
    ".claude-plugin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dogfood": "node dist/cli.js audit test",
    "demo:bad": "node dist/cli.js audit fixtures/bad-project --mutate fixtures/bad-project/src/pricing.ts",
    "demo:good": "node dist/cli.js audit fixtures/good-project --mutate fixtures/good-project/src/pricing.ts",
    "demo:gif": "npm run build && node scripts/demo-gif.mjs",
    "prepare": "npm run build"
  },
  "keywords": [
    "testing",
    "test-smells",
    "mutation-testing",
    "agent-skills",
    "claude-code",
    "codex",
    "cursor",
    "ai",
    "vitest",
    "jest",
    "lint"
  ],
  "license": "MIT",
  "dependencies": {
    "@babel/parser": "^7.29.0"
  },
  "devDependencies": {
    "@babel/types": "^8.1.2",
    "@types/node": "^22.20.5",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
